# Скопируйте этот файл в .env и заполните реальными значениями.
# Файл .env никогда не должен попадать в Git (см. .gitignore).

# --- Обязательные ---
SECRET_KEY=change-me-to-a-random-64-character-string
DATABASE_URL=postgresql://user:password@localhost:5432/kavkaz_car

# --- Окружение ---
FLASK_ENV=production
FLASK_DEBUG=0
FORCE_HTTPS=1
SITE_URL=https://kavkaz-car.ru

# --- Хранилище фотографий: local (для разработки) или cloudinary ---
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Админка ---
ADMIN_SECRET=change-me-too

# --- Прочее ---
SUPPORT_PHONE=+7 900 000-00-00
