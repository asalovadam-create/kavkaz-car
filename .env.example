# Скопируйте этот файл в .env и заполните РЕАЛЬНЫМИ значениями.
# Файл .env никогда не должен попадать в Git (см. .gitignore).
# ВНИМАНИЕ: в этом файле должны быть только заглушки — никаких настоящих паролей и ключей.

# --- Обязательные ---
# Случайная строка от 32 символов:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-with-secrets-token-hex-32
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Окружение ---
FLASK_ENV=production
FLASK_DEBUG=0
FORCE_HTTPS=1          # для локальной разработки по http поставьте 0, иначе не сохранится вход
SITE_URL=https://kavkaz-car.ru
TRUSTED_PROXIES=1      # сколько прокси перед приложением (Render = 1)

# --- Хранилище фотографий: local (только для разработки) или cloudinary ---
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Админка ---
# Дополнительный код при входе в админку (вторая линия защиты). Задайте длинную случайную строку.
ADMIN_SECRET=

# --- Контакты поддержки (показываются на страницах «Помощь» и «Заказ») ---
SUPPORT_PHONE=
SUPPORT_TELEGRAM=      # @username
SUPPORT_WHATSAPP=      # +79001234567

# --- Оплата тарифов ---
# manual   — заявка + ручное подтверждение в админке (работает сразу)
# rollypay — онлайн-оплата через Rolly Pay (заполните три значения ниже)
PAYMENT_PROVIDER=manual
ROLLYPAY_API_URL=
ROLLYPAY_API_KEY=
ROLLYPAY_SECRET=
ROLLYPAY_SHOP_ID=
ROLLYPAY_SIGNATURE_HEADER=X-Signature

# --- Уведомления админу в Telegram (необязательно): жалобы и заявки на оплату ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
