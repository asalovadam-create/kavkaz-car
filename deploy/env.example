# Скопируйте в файл .env НА СЕРВЕРЕ (cp deploy/env.example .env, затем nano .env).
# Без кавычек и пробелов вокруг "=". Файл .env в git не попадает — это правильно.

# --- Для docker compose ---
DOMAIN=kavkaz-car.ru
ACME_EMAIL=ваша_почта@example.com
# Пароль базы: только буквы и цифры. Получить: openssl rand -hex 16
DB_PASSWORD=

# --- Для сайта ---
FLASK_ENV=production
FLASK_DEBUG=0
FORCE_HTTPS=1
TRUSTED_PROXIES=1
SITE_URL=https://kavkaz-car.ru
# ВАЖНО: возьмите те же значения, что сейчас на Render, тогда адрес админки и входы не изменятся
SECRET_KEY=
ADMIN_PATH=
ADMIN_SECRET=
SUPPORT_PHONE=
